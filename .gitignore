# Secrets / generated credentials — never commit
secrets-vault/*
!secrets-vault/.gitkeep

# Cluster access — machine-specific, regenerated by scripts/03-bootstrap-cluster.sh
kubeconfig
talosconfig
*.kubeconfig
*.talosconfig

# Talos install images downloaded from Image Factory
*.iso
talos/_out/

# VirtualBox disk images, in case one ever ends up inside the repo dir
# (VBoxManage's "Default machine folder" resolution can misbehave when
# scripts/01-create-vms.sh is run somewhere other than the intended Debian
# 12 host — see chat/commit notes)
*.vdi

# Sealed-secrets controller keypair backup (also under secrets-vault/, kept here as a safety net)
*-sealed-secrets-key.yaml

# Local overrides
config/cluster.env.local
.env
.DS_Store
*.swp

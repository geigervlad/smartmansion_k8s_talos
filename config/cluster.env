#!/usr/bin/env bash
# ==============================================================================
# SmartMansion cluster configuration — single source of truth.
# Every script under scripts/ sources this file. Adjust values here, not in
# the scripts themselves. Copy to config/cluster.env.local and adjust there
# instead if you want to keep local overrides out of git (cluster.env.local
# is gitignored and, if present, is sourced *after* this file).
# ==============================================================================

# ------------------------------------------------------------------------------
# Cluster identity
# ------------------------------------------------------------------------------
CLUSTER_NAME="smartmansion"
TALOS_VERSION="v1.9.1"          # check https://github.com/siderolabs/talos/releases for newer
KUBERNETES_VERSION=""            # empty = let talosctl pick its default compatible version

# ------------------------------------------------------------------------------
# Nodes — 3 control-plane + 3 worker, all as VirtualBox VMs on this one host.
# Arrays must all be the same length and index-aligned (NODE_NAMES[i] describes
# the same node as NODE_ROLES[i], NODE_IPS[i], etc).
# ------------------------------------------------------------------------------
NODE_NAMES=(cp1 cp2 cp3 worker1 worker2 worker3)
NODE_ROLES=(controlplane controlplane controlplane worker worker worker)
NODE_IPS=(192.168.178.50 192.168.178.51 192.168.178.52 192.168.178.60 192.168.178.61 192.168.178.62)
NODE_CPUS=(2 2 2 4 4 4)
NODE_RAM_MB=(4096 4096 4096 8192 8192 8192)
NODE_OS_DISK_GB=(20 20 20 20 20 20)
# Longhorn only runs on workers (control-plane nodes keep the default
# NoSchedule taint, so Longhorn engine pods wouldn't land there anyway).
NODE_LONGHORN_DISK_GB=(0 0 0 100 100 100)

# ------------------------------------------------------------------------------
# Networking
# ------------------------------------------------------------------------------
NETWORK_GATEWAY="192.168.178.1"
NETWORK_SUBNET_CIDR="192.168.178.0/24"
NETWORK_DNS_SERVERS="192.168.178.1"
# Shared control-plane VIP (Talos-managed) so the k8s API stays reachable if
# any single CP node is down. Must be a free IP in the same subnet, NOT one
# of the NODE_IPS above.
CLUSTER_VIP="192.168.178.55"
CLUSTER_ENDPOINT="https://${CLUSTER_VIP}:6443"

POD_CIDR="10.244.0.0/16"         # Talos default
SERVICE_CIDR="10.96.0.0/12"      # Talos default

# ------------------------------------------------------------------------------
# VirtualBox host settings (Debian 12 host)
# ------------------------------------------------------------------------------
# Must be Bridged, not NAT — Home Assistant needs hostNetwork:true to see real
# mDNS/SSDP multicast traffic from IoT devices on the LAN.
# Find the right value with: VBoxManage list bridgedifs | grep ^Name
VBOX_BRIDGE_ADAPTER="enp3s0"
VBOX_VM_PREFIX="smartmansion"
TALOS_OUT_DIR="talos/_out"

# ------------------------------------------------------------------------------
# Domains / TLS
# ------------------------------------------------------------------------------
DOMAIN_NEXTCLOUD="smartmansion.de"
DOMAIN_HOMEASSISTANT="home.smartmansion.de"
DOMAIN_ONLYOFFICE="office.smartmansion.de"
DOMAIN_ARGOCD="argocd.smartmansion.de"
LETSENCRYPT_EMAIL="geiger.vlad.mihaly@gmail.com"

# DNS-01 solver. Strato has no ACME-compatible DNS API, so the ClusterIssuer
# uses the deSEC webhook against a *delegated* _acme-challenge subdomain.
# See docu/09-cert-manager-dns.md before running 06-install-cert-manager.sh.
ACME_DNS01_PROVIDER="desec"      # "desec" or "selfsigned" (see docu/09)
DESEC_NAMESERVERS="ns1.desec.io. ns2.desec.io."

# ------------------------------------------------------------------------------
# DynDNS (Strato A-records — public IP changes daily)
# Verify the exact update endpoint/protocol for your Strato DynDNS product in
# the Strato customer panel before first run; this is the commonly documented
# one but Strato has changed this before. See docu/09-cert-manager-dns.md.
# ------------------------------------------------------------------------------
DYNDNS_UPDATE_URL="https://dyndns.strato.com/nic/update"
DYNDNS_HOSTNAMES="smartmansion.de home.smartmansion.de office.smartmansion.de"
DYNDNS_INTERVAL_MINUTES=5

# ------------------------------------------------------------------------------
# GitOps
# ------------------------------------------------------------------------------
GITOPS_REPO_URL="https://github.com/geigervlad/Smartmansion_k8s_talos.git"
GITOPS_REPO_BRANCH="main"
ARGOCD_NAMESPACE="argocd"

# ------------------------------------------------------------------------------
# Storage
# ------------------------------------------------------------------------------
LONGHORN_REPLICA_COUNT=3         # one replica per worker node

# ------------------------------------------------------------------------------
# Local override hook (gitignored) — leave as-is unless you know you need it
# ------------------------------------------------------------------------------
if [[ -f "$(dirname "${BASH_SOURCE[0]}")/cluster.env.local" ]]; then
  # shellcheck disable=SC1091
  source "$(dirname "${BASH_SOURCE[0]}")/cluster.env.local"
fi
